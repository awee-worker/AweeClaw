# =========================================================
# ONLYOFFICE Docs 部署配置（.env.example → 复制为 .env 并修改）
# 使用方法: cp .env.example .env && vim .env
# =========================================================

# ---- 镜像 ----
# 官方源（服务器在国外或可直连 Docker Hub 时用）：
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.4.0.1
# 国内服务器 Docker Hub 拉不动时，改用加速源镜像：
# ONLYOFFICE_IMAGE=docker.xuanyuan.run/onlyoffice/documentserver:9.4.0.1

# ---- 端口 ----
# 宿主机映射端口（对外服务端口，容器内固定 80）
DS_PORT=8080

# ---- 公网入口（浏览器 / DS 回调访问用，必填）----
# DS 与网关共用的公网域名基址（带 https://，不含尾部斜杠）
PUBLIC_DS_URL=https://onlyoffice.aweeclaw.com
# 网关对外路径前缀（需在外层 Nginx 配置对应转发，见 README）
GW_BASE_PATH=/oo-gw
# 网关本机监听端口（仅 127.0.0.1，供外层反代转发）
GW_PORT=8090

# ---- JWT（强烈建议开启，供集成方鉴权）----
# 用 openssl rand -hex 32 生成一个强随机值，集成时必须替换！
JWT_ENABLED=true
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_HEX_32

# ---- 网关管理（公网部署建议设置）----
# 强制保存(/save)与删除(/files/x)操作需携带同值请求头 x-gw-key；留空=不鉴权（仅限内网调试）
GW_ADMIN_KEY=
# DS 容器内部地址（容器网络内用 compose 服务名，勿改；宿主直跑调试可设 http://127.0.0.1:<DS_PORT>）
DS_INTERNAL=http://onlyoffice-document-server
# 上传文档超过该小时数未修改则自动清理（防孤儿堆积）
TTL_HOURS=24

# ---- 时区 ----
TZ=Asia/Shanghai
