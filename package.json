{
  "name": "aweeclaw",
  "version": "1.4.0",
  "description": "AweeClaw - Connect AI to Your World",
  "productName": "AweeClaw",
  "author": "awee <aweelee@qq.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/aweelee/aweeclaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/aweelee/aweeclaw.git"
  },
  "main": "dist/main/appBootstrap.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.main.json --noEmit --watch",
    "dev:renderer": "vite",
    "build": "vite build",
    "build:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.main.json --noEmit",
    "build:renderer": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist-w": "node scripts/build-cross-platform.js --target=win",
    "dist-w-32": "node scripts/build-cross-platform.js --target=win --arch=ia32",
    "dist-w-arm64": "node scripts/build-cross-platform.js --target=win --arch=arm64",
    "dist-m": "node scripts/build-cross-platform.js --target=mac",
    "dist-m-arm64": "node scripts/build-cross-platform.js --target=mac --arch=arm64",
    "dist-l": "node scripts/build-cross-platform.js --target=linux",
    "dist-l-32": "node scripts/build-cross-platform.js --target=linux --arch=ia32",
    "dist-l-arm64": "node scripts/build-cross-platform.js --target=linux --arch=arm64",
    "dist-l-deb": "node scripts/build-cross-platform.js --target=linux --format=deb",
    "dist-all": "node scripts/build-cross-platform.js --target=all",
    "pack": "npm run build && electron-builder --dir",
    "preview": "npm run build && electron .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "assets:icons": "node scripts/generate-platform-icons.js",
    "postinstall": "node scripts/download-wasm.js",
    "rebuild": "npx electron-rebuild -f -w node-pty",
    "rebuild:all": "npx electron-rebuild -f -w"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.23",
    "@ai-sdk/google": "^3.0.13",
    "@ai-sdk/openai": "^3.0.18",
    "@ai-sdk/openai-compatible": "^2.0.18",
    "@aweeclaw/harness-core": "^1.0.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lancedb/lancedb": "^0.23.0",
    "@larksuiteoapi/node-sdk": "^1.62.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@monaco-editor/react": "^4.6.0",
    "@parcel/watcher": "^2.4.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/dompurify": "^3.0.5",
    "@types/pdf-parse": "^1.1.5",
    "@vscode/ripgrep": "^1.15.9",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.49",
    "bufferutil": "^4.1.0",
    "diff": "^8.0.2",
    "dompurify": "^3.3.1",
    "dugite": "^2.7.1",
    "echarts": "^6.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "framer-motion": "^12.25.0",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "officeparser": "^6.1.1",
    "p-limit": "^3.1.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.4.168",
    "picomatch": "^4.0.3",
    "png2icons": "^2.0.1",
    "ps-list": "^8.1.1",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-virtuoso": "^4.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "shiki": "^4.2.0",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.31.9",
    "tar": "^7.5.15",
    "three": "^0.184.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript-language-server": "^5.1.3",
    "utf-8-validate": "^6.0.6",
    "vscode-langservers-extracted": "^4.10.0",
    "web-tree-sitter": "^0.20.8",
    "word-extractor": "^1.0.4",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.60.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@types/tar": "^6.1.13",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "fast-check": "^4.4.0",
    "fast-json-stable-stringify": "^2.1.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "uri-js": "^4.4.1",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "com.aweeclaw.app",
    "productName": "AweeClaw",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "afterPack": "scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "awee-worker",
      "repo": "aweeclaw",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/dugite/**",
      "node_modules/@lancedb/**",
      "node_modules/@parcel/watcher/**",
      "node_modules/@parcel/watcher-*/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**"
    ],
    "files": [
      "dist/**/*",
      "public/**/*",
      "LICENSE",
      "NOTICE",
      "node_modules/@parcel/watcher/**",
      "node_modules/@parcel/watcher-*/**",
      "node_modules/@lancedb/lancedb*/**",
      "node_modules/@img/sharp*/**",
      "node_modules/sharp/**",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!config.json",
      "!bootstrap.json",
      "!.aweeclaw/**"
    ],
    "win": {
      "icon": "public/brand/icons/app.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AweeClaw",
      "installerIcon": "public/brand/icons/app.ico",
      "uninstallerIcon": "public/brand/icons/app.ico",
      "installerHeaderIcon": "public/brand/icons/app.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "public/brand/icons/app.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "icon": "public/brand/icons/app.png",
      "artifactName": "${productName}-${version}-${arch}-linux.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "resources/tree-sitter",
        "to": "tree-sitter"
      },
      {
        "from": "resources/uiux",
        "to": "uiux"
      },
      {
        "from": "src/main/modules/desktop-control/bin",
        "to": "ocr-scripts"
      }
    ]
  },
  "optionalDependencies": {
    "@lancedb/lancedb-win32-x64-msvc": "^0.22.3",
    "@parcel/watcher-win32-x64": "^2.5.1"
  }
}
